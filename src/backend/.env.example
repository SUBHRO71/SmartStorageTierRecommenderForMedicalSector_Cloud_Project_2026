# AWS uses the standard credential provider chain. Do not put keys in this file.
AWS_DEFAULT_REGION=us-east-1

# Persistence: sqlite for complete local operation; dynamodb after AWS is configured
DATA_BACKEND=sqlite
LOCAL_DB_PATH=./local_scans.db

# DynamoDB
TABLE_NAME=ScanFeatures

# S3
BUCKET_NAME=medical-image-store

# SNS
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:WronglyArchivedTopic

# Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxx

# Local Development
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Local API behavior
AUTH_MODE=local
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
